#!/usr/bin/env bash
# Refuse to commit a credential or the private workspace. The repo is public
# for judging, so anything staged here is effectively published.
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0
while IFS= read -r f; do
  case "$f" in
    private/*|*.private.md)
      echo "BLOCKED  $f is private and must never be committed."
      fail=1; continue;;
    .env|.env.local|.env.*.local)
      echo "BLOCKED  $f holds real credentials and must never be committed."
      fail=1; continue;;
  esac
  [ -f "$f" ] || continue
  case "$f" in *.lock|uv.lock|package-lock.json|*.png|*.jpg|*.jpeg|*.webp|*.gif|*.svg) continue;; esac

  # Any KEY= line in a committed env template must be empty.
  if [ "$(basename "$f")" = ".env.example" ]; then
    if git show ":$f" | grep -qE '^[A-Z_]*(KEY|TOKEN|SECRET|PASSWORD)[A-Z_]*=.+'; then
      echo "BLOCKED  $f has a non-empty credential value. Templates must ship empty."
      fail=1
    fi
  fi

  # A raw EVM private key or mnemonic assigned to a name that says so.
  if git show ":$f" | grep -qiE '(private_?key|mnemonic|deployer_?key)["'"'"']?[[:space:]]*[=:][[:space:]]*["'"'"']?(0x)?[0-9a-f]{64}'; then
    echo "BLOCKED  $f looks like it contains a wallet private key."
    fail=1
  fi

  # Known key shapes: GitLab tokens, Google API keys and service-account keys,
  # Anthropic, OpenAI, GitHub.
  if git show ":$f" | grep -qE 'glpat-[A-Za-z0-9_-]{20,}|glrt-[A-Za-z0-9_-]{20,}|gldt-[A-Za-z0-9_-]{20,}|glptt-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,}|"private_key": *"-----BEGIN|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{40,}|ghp_[A-Za-z0-9]{30,}'; then
    echo "BLOCKED  $f looks like it contains an API key or access token."
    fail=1
  fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
  echo
  echo "Nothing was committed. Remove the secret, or bypass with --no-verify if you are certain."
  exit 1
fi
